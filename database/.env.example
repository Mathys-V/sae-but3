# Modèle de configuration — copier ce fichier en ".env" et remplir avec ses valeurs.
# Le fichier .env est ignoré par Git (il contient le mot de passe) ; lui seul est versionné.
#
# Format : postgresql://utilisateur:motdepasse@hôte:port/base
#   - en local :  postgresql://postgres:motdepasse@localhost:5432/EvilJV_db
#   - sur la VM : postgresql://sae_user:motdepasse@IP_DE_LA_VM:5432/EvilJV_db
DATABASE_URL=postgresql://user:motdepasse@localhost:5432/EvilJV_db