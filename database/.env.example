# Configuration de connexion à la base de données EvilJV
# Copier ce fichier en ".env" et renseigner les identifiants fournis par l'équipe.
#
# Le fichier .env contient les informations de connexion personnelles
# et ne doit JAMAIS être commité sur Git.
#
# Base partagée sur la VM2 :
# - Hôte : 10.1.136.68
# - Port : 5432
# - Base : EvilJV_db
# - Utilisateur : eviljv_app
#
# Remplacer MOT_DE_PASSE par le mot de passe communiqué par l'équipe.

DATABASE_URL=postgresql://eviljv_app:MOT_DE_PASSE@10.1.136.68:5432/EvilJV_db

